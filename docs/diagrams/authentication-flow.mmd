flowchart TB
    %% Flow A — Authentication overview
    %% Detail: register-flow.mmd and login-flow.mmd
    %% Layout: green centre line = success path. Side branches = choose path.
    %% No long crossing arrows.

    start(["START<br/>Open application"])

    subgraph entry["1. Application entry"]
        direction TB
        openApp["Open application"]
        choose{"Register or log in?"}

        openApp --> choose
    end

    start --> openApp

    subgraph paths["2. Choose path"]
        direction TB
        goRegister["Follow Register flow<br/>see register-flow.mmd"]
        goLogin["Follow Login flow<br/>see login-flow.mmd"]
        endOk(["END<br/>JWT stored · authenticated access"])

        goRegister --> endOk
        goLogin --> endOk
    end

    choose -->|REGISTER| goRegister
    choose -->|LOG IN| goLogin

    legend["Reading rule: this overview only chooses the path.<br/>Register and login details, including error returns, are in the separate diagrams."]

    classDef startNode fill:#16a34a,stroke:#14532d,stroke-width:3px,color:#fff
    classDef entryAction fill:#dbeafe,stroke:#3b82f6,color:#0f172a
    classDef pathAction fill:#dcfce7,stroke:#16a34a,color:#0f172a
    classDef decision fill:#fef3c7,stroke:#d97706,color:#0f172a
    classDef endNode fill:#dcfce7,stroke:#16a34a,stroke-width:2px,color:#14532d
    classDef legendBox fill:#f8fafc,stroke:#cbd5e1,color:#334155

    class start startNode
    class openApp entryAction
    class goRegister,goLogin pathAction
    class choose decision
    class endOk endNode
    class legend legendBox

    style entry fill:#eff6ff,stroke:#93c5fd,stroke-width:2px,color:#1e3a8a
    style paths fill:#f0fdf4,stroke:#86efac,stroke-width:2px,color:#166534
