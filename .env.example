# Main Responsibility: Example environment variables for local Docker / backend setup.
# Copy to .env and change secrets before running. Do not commit real .env files.

# Postgres database name, user, and password (used by postgres service and Spring).
POSTGRES_DB=finance_tracker
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# JDBC URL as seen from the backend container (hostname "postgres" is the Compose service name).
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/finance_tracker

# Signing key for JWTs — change this for any shared or production-like environment.
JWT_SECRET=change-me-in-local-dev

# Directory inside the backend container where uploaded files are stored.
UPLOAD_DIR=/app/uploads

# RapidOCR sidecar URL as seen from the backend container (Compose service name "ocr").
# Do not publish the OCR port to the host; leave this as the internal URL.
OCR_BASE_URL=http://ocr:8080
# Optional read timeout for POST /ocr (ms); plan default ~30s.
OCR_TIMEOUT_MS=30000

# Groq Cloud (receipt LLM parser) — free-tier API key from https://console.groq.com
# Same HTTP shape as OpenAI chat completions; base URL is Groq, not api.openai.com / xAI.
# Required for successful processing; empty key → PROCESSING_FAILED (no silent mock).
GROQ_API_KEY=
GROQ_API_BASE_URL=https://api.groq.com/openai/v1
# Default model ID must stay available on Groq; llama-3.3-70b-versatile is deprecated (404).
GROQ_MODEL=openai/gpt-oss-120b
# Optional read timeout for chat completions (ms); plan default ~20s.
GROQ_TIMEOUT_MS=20000


# Frontend (host only) — base URL if the SPA talks to the API without the Vite proxy.
VITE_API_BASE_URL=http://localhost:8080
